<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
      INTERNET 是必须的。
      缺了它不是"网络连不上"这么客气 —— 内核直接拒绝 socket() 系统调用，
      Java 侧报 EPERM (Operation not permitted)，Node 侧报 listen EACCES。
      这两个错误看起来都像 SELinux 或权限配置问题，极易误判（实测踩了
      一个多小时：查 seapp_contexts、比对旧壳的 MCS category、改 targetSdk
      27->28，全是在追一个根本不存在的 SELinux 问题）。
    -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- 保活三件套 -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!--
      存储权限（2026-10-30 补，零八在新壳里实测发现的第一个真缺陷）。

      症状：touch /storage/emulated/0/DSH-Workspace/x → Operation not permitted
            读可以，写不行；用 su -c 写可以（root 不受限）。

      原因：targetSdk=28 走的是「旧存储模型」，读写外部存储必须显式声明这两条。
            漏了它们不是"降级"而是"完全没有"——dumpsys 里一条存储权限都没有。

      为什么不需要 MANAGE_EXTERNAL_STORAGE：
            targetSdk=28 只要这两条就够管 /sdcard 全域，不必申请那种全盘管理权限
            （旧壳也没真正拿到 MANAGE_EXTERNAL_STORAGE，granted=false）。

      ⚠ 提醒：用 su -c 写出来的文件属主是 root，用 App 身份写的是 u0_a295。
              两种属主混在一个工作区里，将来查权限问题会多一个变量 —— 别混用。
    -->
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" />

    <!--
      usesCleartextTraffic 是必须的。
      targetSdk >= 28 默认禁止明文 HTTP，而引擎只在 127.0.0.1 上用 http 提供服务
      （dsh web 不带 TLS）。不加这条，WebView 会直接白屏并报
      net::ERR_CLEARTEXT_NOT_PERMITTED。
      范围限于本机回环，不放宽任何对外连接。
    -->
    <application
        android:allowBackup="false"
        android:usesCleartextTraffic="true"
        android:label="dsh host"
        android:supportsRtl="true"
        android:theme="@style/Theme.DshHost">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="dsh host">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
          前台服务持有引擎的生命周期。startForeground 的常驻通知把进程提到前台
          优先级，避免切到后台后被常规回收；START_STICKY 让它被杀后自动重启。

          targetSdk 28 不需要 android:foregroundServiceType（那是 targetSdk 34+
          配合 Android 14 才强制的），这里省略是刻意的。
        -->
        <service
            android:name=".EngineService"
            android:exported="false" />

        <receiver
            android:name=".BootReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>
    </application>

</manifest>
