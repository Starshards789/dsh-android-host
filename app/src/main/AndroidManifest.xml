<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
      INTERNET 是必须的。
      缺了它不是"网络连不上"这么客气 —— 内核直接拒绝 socket() 系统调用，
      Java 侧报 EPERM (Operation not permitted)，Node 侧报 listen EACCES。
      这两个错误看起来都像 SELinux 或权限配置问题，极易误判（实测踩了
      一个多小时：查 seapp_contexts、比对旧壳的 MCS category、改 targetSdk
      27->28，全是在追一个根本不存在的 SELinux 问题）。
    -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- 保活三件套 -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:allowBackup="false"
        android:label="dsh host"
        android:supportsRtl="true"
        android:theme="@style/Theme.DshHost">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="dsh host">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
          前台服务持有引擎的生命周期。startForeground 的常驻通知把进程提到前台
          优先级，避免切到后台后被常规回收；START_STICKY 让它被杀后自动重启。

          targetSdk 28 不需要 android:foregroundServiceType（那是 targetSdk 34+
          配合 Android 14 才强制的），这里省略是刻意的。
        -->
        <service
            android:name=".EngineService"
            android:exported="false" />

        <receiver
            android:name=".BootReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>
    </application>

</manifest>
