<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
      INTERNET 是必须的。
      缺了它不是"网络连不上"这么客气 —— 内核直接拒绝 socket() 系统调用，
      Java 侧报 EPERM (Operation not permitted)，Node 侧报 listen EACCES。
      这两个错误看起来都像 SELinux 或权限配置问题，极易误判（实测踩了
      一个多小时：查 seapp_contexts、比对旧壳的 MCS category、改 targetSdk
      27->28，全是在追一个根本不存在的 SELinux 问题）。
    -->
    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:allowBackup="false"
        android:label="dsh host"
        android:supportsRtl="true"
        android:theme="@style/Theme.DshHost">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="dsh host">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>
